# React Development Server Network Configuration
# Copy this file to .env to enable network access

# Allow access from any host on the network
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Bind to all network interfaces (not just localhost)
HOST=0.0.0.0

# Set the port for the development server
PORT=3000

# Skip preflight checks for development
SKIP_PREFLIGHT_CHECK=true

# Disable HTTPS and SSL checks for network access
HTTPS=false
SSL_CRT_FILE=
SSL_KEY_FILE=

# Allow all hosts and disable secure connection requirements
GENERATE_SOURCEMAP=false
BROWSER=none
CI=false
